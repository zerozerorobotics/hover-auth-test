</style>

<section>
  <div class='e-box'>
    <div class='e-text'>
      <p class='e-title'>Contact Us</p>
      <p class='e-con'>
        If you have any questions or inquiries. Feel free to contact the
        respective email addresses based on your needs.
      </p>
    </div>

    <div class='e-bot'>
      <div class='bot e-dw1'>
        <img
          src='https://cdn.shopify.com/s/files/1/0796/1362/4605/files/Customer_Service.png?v=1701935579'
          alt=''
          class='e-img'
        >
        <p class='bot-title'>Customer Service</p>
        <a href='mailto:support@hoverair.com'>support@hoverair.com</a>
      </div>

      <div class='bot e-dw2'>
        <img
          src='https://cdn.shopify.com/s/files/1/0796/1362/4605/files/Marketing_Collaboration.png?v=1701936263'
          alt=''
          class='e-img'
        >
        <p class='bot-title'>Marketing Collaboration</p>
        <a href='mailto:marketing@hoverair.com'>marketing@hoverair.com</a>
      </div>

      <div class='bot e-dw3'>
        <img
          src='https://cdn.shopify.com/s/files/1/0796/1362/4605/files/Wholesale_and_Distributors.png?v=1701936263'
          alt=''
          class='e-img'
        >
        <p class='bot-title'>Wholesale and Distributors</p>
        <a href='mailto:sales@hoverair.com'>sales@hoverair.com</a>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', (event) => {
    ScrollTrigger.create({
      trigger: '.e-title',
      //markers: true,
      start: 'top 80%',
      end: 'top 80%',
      animation: gsap
        .timeline()
        .fromTo(
          '.e-title',
          { y: 100, duration: 0.8, opacity: 0 },
          { y: 0, opacity: 1, duration: 0.8 }
        ),
    });
    ScrollTrigger.create({
      trigger: '.e-con',
      //markers: true,
      start: 'top 80%',
      end: 'top 80%',
      animation: gsap
        .timeline()
        .fromTo(
          '.e-con',
          { y: 100, duration: 1, opacity: 0 },
          { y: 0, opacity: 1, duration: 1 }
        ),
    });
    ScrollTrigger.create({
      trigger: '.e-dw1',
      //markers: true,
      start: 'top 80%',
      end: 'top 80%',
      animation: gsap
        .timeline()
        .fromTo(
          '.e-dw1',
          { y: 100, duration: 1, opacity: 0 },
          { y: 0, opacity: 1, duration: 1 }
        ),
    });
    ScrollTrigger.create({
      trigger: '.e-dw2',
      //markers: true,
      start: 'top 80%',
      end: 'top 80%',
      animation: gsap
        .timeline()
        .fromTo(
          '.e-dw2',
          { y: 100, duration: 1.3, opacity: 0 },
          { y: 0, opacity: 1, duration: 1.3 }
        ),
    });
    ScrollTrigger.create({
      trigger: '.e-dw3',
      //markers: true,
      start: 'top 80%',
      end: 'top 80%',
      animation: gsap
        .timeline()
        .fromTo(
          '.e-dw3',
          { y: 100, duration: 1.5, opacity: 0 },
          { y: 0, opacity: 1, duration: 1.5 }
        ),
    });
  });
</script>

