<style>
  @media (min-width: 750px) {
    * {
      margin: 0;
      padding: 0;
    }

    .e-box {
      width: 100%;
      height: 34.375vw;
      background: rgba(246, 250, 255, 0.9);
    }

    .e-text {
      height: 11.25vw;
      padding-top: 4.7916667vw;
    }

    .e-title {
      width: 14.333333vw;
      height: 2.96875vw;
      font-size: 2.39583333vw;
      {% comment %} font-family: Montserrat, Montserrat; {% endcomment %}
      font-weight: 600;
      color: #000000;
      line-height: 2.96875vw;
      margin: auto;
    }

    .e-con {
      width: 29.6875vw;
      height: 2.239583333vw;
      font-size: 0.83333vw;
      font-family: Poppins;
      font-weight: 400;
      color: #000000;
      line-height: 1.04166667vw;
      margin: 1.25vw auto 3.48958333vw;
      text-align: center;
    }

    .e-bot {
      width: 62.39583333vw;
      margin: 3.48958333vw auto;
      display: flex;
    }

    .bot {
      width: 20.10416667vw;
      height: 11.4583333vw;
      background: #FFFFFF;
      box-shadow: 0px 6px 18px 0px rgba(12, 83, 172, 0.08);
      border-radius: 12px;
      position: relative;
    }

    .bot:nth-child(2) {
      margin: 0 1.04166667vw;
    }

    .bot-title {
      height: 1.197916667vw;
      font-size: 0.833333vw;
      {% comment %} font-family: Montserrat, Montserrat; {% endcomment %}
      font-weight: bold;
      color: #000000;
      line-height: 1.0416667vw;
      margin: 1.5vw 0 0 3.4375vw;
    }

    .bot a {
      text-align: center;
      /* width: 13.697916667vw; */
      height: 1.197916667vw;
      font-size: 1.0416667vw;
      {% comment %} font-family: Montserrat, Montserrat; {% endcomment %}
      font-weight: bolder;
      color: #000000;
      line-height: 1.25vw;
      display: block;
      margin: 4.114583333vw auto 0;
    }

    .e-img{
      width: 100%;
      position: absolute;
      top: 2px;
      left: 2px;
    }
  }

  @media (max-width: 749px) {
    * {
      margin: 0;
      padding: 0;
    }

    .e-box {
      width: 100%;
      height: 187.0667vw;
      background: rgba(246, 250, 255, 0.9);
    }

    .e-text {
      height: 50.8vw;
      padding-top: 10.6667vw;
    }

    .e-title {
      width: 60.5333vw;
      height: 9.7333vw;
      font-size: 8vw;
      {% comment %} font-family: Montserrat, Montserrat; {% endcomment %}
      font-weight: bold;
      color: #000000;
      line-height: 9.7333vw;
      margin-left: 10.6667vw;
    }

    .e-con {
      width: 71.7333vw;
      height: 13.6vw;
      font-size: 3.7333vw;
      font-family: Poppins;
      font-weight: 400;
      color: #000000;
      line-height: 17px;
      margin: 4.8vw 0 8vw 10.6667vw;
    }

    .e-bot {
      width: 78.6667vw;
      margin: auto;
    }

    .bot {
      width: 78.6667vw;
      height: 36.1333vw;
      background: #FFFFFF;
      box-shadow: 0px 1.6vw 4.8vw 0px rgba(12, 83, 172, 0.08);
      border-radius: 1.6vw;
      padding-top: 3.8667vw;
      position: relative;
    }

    .bot:nth-child(2) {
      margin: 4.8vw 0;
    }

    .bot-title {
      width: 68.8vw;
      font-size: 3.7333vw;
      {% comment %} font-family: Montserrat, Montserrat; {% endcomment %}
      font-weight: bold;
      color: #000000;
      line-height: 2.6667vw;
      margin: 2vw 0 0 15.4667vw;
    }

    .bot a {
      width: 63.0667vw;
      height: 8vw;
      font-size: 4vw;
      {% comment %} font-family: Montserrat, Montserrat; {% endcomment %}
