{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mb }}px;
    padding-bottom: {{ section.settings.padding_bottom_mb }}px;
  }
  @media screen and (min-width: 1024px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{{ 'help-center.css' | asset_url | stylesheet_tag }}
<script src="{{ 'help-center.js' | asset_url }}" defer></script>

{%- liquid
  assign hub_url = section.settings.hub_page.url | default: '/pages/help-center'
  assign search_q = request.query_parameters.q | strip
  assign active_node = request.query_parameters.node | default: 'all'
  assign browse_page = request.query_parameters.page | default: '1' | plus: 0
  assign browse_limit = section.settings.browse_page_size
  assign nav_nodes_sorted = shop.metaobjects.help_nav_node.values | sort: 'sort_order'

  assign browsing_all = false
  if active_node == 'all' or active_node == blank
    assign browsing_all = true
  endif

  comment
    单次遍历同时产出两份节点白名单，避免祖先链判断在计数 / SSR 列表 / JSON 里重复三遍：
      visible_nodes  —— 自身与所有祖先都可见的节点，供客户端切换用的 JSON 使用
      included_nodes —— 当前选中节点及其子孙，供计数与 SSR 首屏列表使用
  endcomment
  assign visible_nodes = '|'
  assign included_nodes = '|'
  assign active_node_label = 'All'

  for node in nav_nodes_sorted
    assign node_handle = node.system.handle | default: node.handle
    if node_handle == blank
      continue
    endif
    if node.visible.value == false
      continue
    endif

    if node_handle == active_node
      assign active_node_label = node.title.value | default: node_handle
    endif

    assign ancestor_hidden = false
    assign under_active = false
    assign walk = node
    for i in (1..10)
      assign parent_obj = walk.parent.value
      if parent_obj == blank
        break
      endif
      if parent_obj.visible.value == false
        assign ancestor_hidden = true
        break
      endif
      assign parent_handle = parent_obj.system.handle | default: parent_obj.handle | default: ''
      if parent_handle == blank
        break
      endif
      if parent_handle == active_node
        assign under_active = true
      endif
      assign walk = parent_obj
    endfor

    if ancestor_hidden
      continue
    endif
    assign visible_nodes = visible_nodes | append: node_handle | append: '|'

    if browsing_all or node_handle == active_node or under_active
      assign included_nodes = included_nodes | append: node_handle | append: '|'
    endif
  endfor

  comment
    文章去重后计数。article.handle 为空说明引用的 Page 已删除或未发布，
    直接跳过，否则会渲染出空白卡片并把计数算大。
  endcomment
  assign active_node_count = 0
  assign counted_handles = '|'
  if search_q == blank
    for node in nav_nodes_sorted
      assign node_handle = node.system.handle | default: node.handle
      assign node_token = node_handle | prepend: '|' | append: '|'
      unless included_nodes contains node_token
        continue
      endunless
      for article in node.articles.value
        if article.handle == blank
          continue
        endif
        assign token = article.handle | prepend: '|' | append: '|'
        unless counted_handles contains token
          assign counted_handles = counted_handles | append: article.handle | append: '|'
          assign active_node_count = active_node_count | plus: 1
        endunless
      endfor
    endfor
  endif
-%}

<div
  class="help-center-hub page-width"
  data-help-hub
  data-proxy-base="/apps/help/search"
  data-browse-limit="{{ browse_limit }}"
  data-hub-url="{{ hub_url }}"
>
  <header class="help-center-hub__header">
    <h1 class="help-center-hub__title">{{ section.settings.title }}</h1>
    <div class="help-center-hub__search-wrap">
      {% render 'help-search-bar', query: search_q, placeholder: section.settings.search_placeholder %}
    </div>
  </header>

  <div class="help-center-hub__layout">
    <aside class="help-center-hub__sidebar" aria-label="Help categories">
      <button
        type="button"
        class="help-center-hub__nav-toggle"
        data-help-nav-open
        data-active-label="{{ active_node_label | escape }}"
        aria-expanded="false"
        aria-controls="help-nav-drawer"
      >
        <span class="help-center-hub__nav-toggle-label">Categories</span>
        <span class="help-center-hub__nav-toggle-value" data-help-nav-label>{{ active_node_label }}</span>
        <span class="help-center-hub__nav-toggle-count" data-help-nav-toggle-count {% if search_q != blank %}hidden{% endif %}>{{ active_node_count }}</span>
        <span class="help-center-hub__nav-toggle-icon" aria-hidden="true"></span>
      </button>
      <div
        class="help-center-hub__sidebar-inner"
        id="help-nav-drawer"
        data-help-nav-panel
        role="dialog"
        aria-modal="true"
        aria-labelledby="help-nav-drawer-title"
        aria-hidden="true"
      >
        <div class="help-center-hub__drawer-header">
          <h2 class="help-center-hub__drawer-title" id="help-nav-drawer-title">Categories</h2>
          <button type="button" class="help-center-hub__drawer-close" data-help-nav-close aria-label="Close categories">×</button>
        </div>
        {% render 'help-nav-tree',
          active_handle: active_node,
          hub_url: hub_url,
          active_node_count: active_node_count,
          nav_nodes_sorted: nav_nodes_sorted
        %}
      </div>
    </aside>

    <div class="help-center-hub__main">
      <p class="help-center-hub__count" data-help-results-count {% if search_q != blank %}hidden{% endif %}>
        <span data-help-results-number>{% if search_q == blank %}{{ active_node_count }}{% else %}0{% endif %}</span>
        <span data-help-results-suffix>{% if search_q != blank %}results{% else %}articles{% endif %}</span>
      </p>

      <div class="help-center-hub__results" data-help-results-list>
        {%- if search_q == blank -%}
          {%- comment -%}
            首屏 SSR 列表（无 JS / SEO 用）。节点顺序按 Admin sort_order，
            载入后 JS 会用完整树的 DFS 重绘，顺序与 Admin 一致。
          {%- endcomment -%}
          {%- assign shown = '|' -%}
          {%- assign collected = 0 -%}
          {%- assign offset = browse_page | minus: 1 | times: browse_limit -%}
          {%- assign browse_end = offset | plus: browse_limit -%}

          {%- for node in nav_nodes_sorted -%}
            {%- assign node_handle = node.system.handle | default: node.handle -%}
            {%- assign node_token = node_handle | prepend: '|' | append: '|' -%}
            {%- unless included_nodes contains node_token -%}
              {%- continue -%}
            {%- endunless -%}

            {%- for article in node.articles.value -%}
              {%- if article.handle == blank -%}
                {%- continue -%}
              {%- endif -%}
              {%- assign token = article.handle | prepend: '|' | append: '|' -%}
              {%- unless shown contains token -%}
                {%- assign shown = shown | append: article.handle | append: '|' -%}
                {%- if collected >= offset and collected < browse_end -%}
                  {% render 'help-article-card', article: article %}
                {%- endif -%}
                {%- assign collected = collected | plus: 1 -%}
              {%- endunless -%}
            {%- endfor -%}
          {%- endfor -%}

          {%- if collected == 0 -%}
            <p class="help-center-hub__empty">No articles in this category yet.</p>
          {%- endif -%}
        {%- else -%}
          <p class="help-center-hub__loading">Searching…</p>
        {%- endif -%}
      </div>

      <nav class="help-pagination" data-help-pagination hidden aria-label="Pagination"></nav>
    </div>
  </div>

  <div class="help-center-hub__overlay" data-help-nav-overlay hidden></div>

  <script type="application/json" data-help-bootstrap>
    {
      "query": {{ search_q | json }},
      "node": {{ active_node | json }},
      "page": {{ browse_page | json }},
      "limit": {{ browse_limit | json }}
    }
  </script>

  {%- comment -%} 全量可见目录树，供 JS 切换节点时免刷新渲染 {%- endcomment -%}
  <script type="application/json" data-help-browse-data>
  {
    "nodes": {
      {%- assign node_first = true -%}
      {%- for node in nav_nodes_sorted -%}
        {%- assign node_handle = node.system.handle | default: node.handle -%}
        {%- assign node_token = node_handle | prepend: '|' | append: '|' -%}
        {%- unless visible_nodes contains node_token -%}
          {%- continue -%}
        {%- endunless -%}
        {%- unless node_first -%},{%- endunless -%}
        {%- assign node_first = false -%}
        {{ node_handle | json }}: {
          "title": {{ node.title.value | default: node_handle | json }},
          "parent": {{ node.parent.value.system.handle | default: node.parent.value.handle | default: '' | json }},
          "sort_order": {{ node.sort_order.value | default: 0 | json }},
          "articles": [
            {%- assign art_first = true -%}
            {%- for article in node.articles.value -%}
              {%- if article.handle == blank -%}
                {%- continue -%}
              {%- endif -%}
              {%- unless art_first -%},{%- endunless -%}
              {%- assign art_first = false -%}
              {%- assign summary = article.metafields.help.summary.value | default: article.content | strip_html | truncate: 160 -%}
              {%- assign products = article.metafields.help.applicable_products.value -%}
              {
                "title": {{ article.title | json }},
                "url": {{ article.url | json }},
                "handle": {{ article.handle | json }},
                "summary": {{ summary | json }},
                "products": {% if products != blank %}{{ products | json }}{% else %}null{% endif %}
              }
            {%- endfor -%}
          ]
        }
      {%- endfor -%}
    }
  }
  </script>
</div>

{% schema %}
{
  "name": "Help Center Hub",
  "tag": "section",
  "class": "section-help-center-hub",
  "settings": [
    {
      "type": "page",
      "id": "hub_page",
      "label": "Help Center page (for nav links)"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title (desktop)",
      "default": "HOVERAir Help Center"
    },
    {
      "type": "text",
      "id": "title_mobile",
      "label": "Title (mobile)",
      "default": "HOVERAir Help Center"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Search for Support"
    },
    {
      "type": "range",
      "id": "browse_page_size",
      "min": 5,
      "max": 30,
      "step": 1,
      "default": 10,
      "label": "Articles per page (browse mode)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top (desktop)",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (desktop)",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mb",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding top (mobile)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mb",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (mobile)",
      "default": 48
    }
  ],
  "presets": [{ "name": "Help Center Hub" }]
}
{% endschema %}
