{%- comment -%}
  Customer Auth Orchestrator V2
  - Session Sync V4 hint-cookie strategy first
  - Google One Tap fallback only when no reusable Keycloak session is hinted/found
  - Single owner for auth redirects to avoid session-sync/GSI navigation races
{%- endcomment -%}

{%- assign auth_base_url = '' -%}
{%- assign auth_realm = '' -%}
{%- assign auth_oidc_client_id = '' -%}
{%- assign google_one_tap_client_id = '' -%}
{%- assign google_one_tap_target = '' -%}
{%- assign auth_env = 'prod' -%}

{%- if shop.domain == 'central-test.hoverair.com' -%}
  {%- assign auth_env = 'test' -%}
  {%- assign auth_base_url = 'https://auth-test.hoverair.com' -%}
  {%- assign auth_realm = 'vcopter' -%}
  {%- assign auth_oidc_client_id = 'shopify-fake-store-central' -%}
  {%- assign google_one_tap_client_id = '564967606393-0vfnmlbt2n7ue3pbcsfl74k1t3tegdvh.apps.googleusercontent.com' -%}
  {%- assign google_one_tap_target = 'central-test' -%}
{%- elsif shop.domain == 'us-test.hoverair.com' -%}
  {%- assign auth_env = 'test' -%}
  {%- assign auth_base_url = 'https://auth-test.hoverair.com' -%}
  {%- assign auth_realm = 'vcopter' -%}
  {%- assign auth_oidc_client_id = 'shopify-fake-store' -%}
  {%- assign google_one_tap_client_id = '564967606393-0vfnmlbt2n7ue3pbcsfl74k1t3tegdvh.apps.googleusercontent.com' -%}
  {%- assign google_one_tap_target = 'us-test' -%}
{%- elsif shop.domain == 'uk.hoverair.com' -%}
  {%- assign auth_base_url = 'https://auth.hoverair.com' -%}
  {%- assign auth_realm = 'hoverair' -%}
  {%- assign auth_oidc_client_id = 'zerozerorobotics-hoverair-uk' -%}
{%- elsif shop.domain == 'global.hoverair.com' -%}
  {%- assign auth_base_url = 'https://auth.hoverair.com' -%}
  {%- assign auth_realm = 'hoverair' -%}
  {%- assign auth_oidc_client_id = 'zerozerorobotics-hoverair-global' -%}
{%- endif -%}

{%- assign auth_return_to = request.path -%}
{%- if request.query_string != blank -%}
  {%- assign auth_return_to = request.path | append: '?' | append: request.query_string -%}
{%- endif -%}

<script>
  (function () {
    "use strict";

    var runtime = window.__authSessionSync = window.__authSessionSync || {};

    var CONFIG = {
      env: {{ auth_env | json }},
      authBaseUrl: {{ auth_base_url | json }},
      realm: {{ auth_realm | json }},
      oidcClientId: {{ auth_oidc_client_id | json }},
      googleClientId: {{ google_one_tap_client_id | json }},
      googleTarget: {{ google_one_tap_target | json }},
      returnTo: {{ auth_return_to | json }},
      isShopifyCustomer: {{ customer | json }} !== null,
      sessionCheckRedirectUri: "https://static.zerozeroplatform.com/session-check",
      shopifyLoginUri: "/customer_authentication/login",
      shopifyLogoutUri: "/account/logout",
      sessionSyncPath: "/pages/session-sync",
      eagerCooldownMs: 60 * 1000,
      iframeCooldownMs: 5 * 1000,
      gsiCooldownMs: 10 * 60 * 1000,
      iframeTimeoutMs: 10000
    };
    runtime.config = CONFIG;

    var KEY = {
      flow: "zz_auth_flow_state",
      explicitLogout: "zz_auth_explicit_logout",
      hintProbeStatus: "zz_auth_hint_probe_status",
      lastGsiPromptAt: "zz_auth_last_gsi_prompt_at",
      legacyEagerAt: "keycloak_v4_eager_ts",
      legacyIframeAt: "keycloak_v4_iframe_last_probe",
      sessionState: "keycloak_v4_session_state"
    };

    var FLOW = {
      IDLE: "idle",
      EXPLICIT_LOGOUT: "explicit_logout",
      SESSION_CHECK_RUNNING: "session_check_running",
      SESSION_SYNC_HANDOFF: "session_sync_handoff",
      GSI_PROMPTING: "gsi_prompting",
      GSI_API_LOGIN: "gsi_api_login",
      GSI_HANDOFF: "gsi_handoff",
      SHOPIFY_MONITORING: "shopify_logged_in_monitoring",
      DONE: "done"
    };

    function getDefaultLogLevel() {
      if (CONFIG.env === "test" || CONFIG.env === "staging") {
        return "info";
      }
      return "silent";
    }

    function getAuthLogLevel() {
      try {
        var override = localStorage.getItem("zz_auth_log_level");
        if (override === "silent" || override === "info" || override === "debug") {
          return override;
        }
        if (localStorage.getItem("zz_auth_debug") === "true") {
          return "debug";
        }
      } catch (e) {
        // Ignore storage failures.
      }
      return getDefaultLogLevel();
    }

    function shouldLog(level) {
      var activeLevel = getAuthLogLevel();
      if (activeLevel === "silent") {
        return false;
      }
      return activeLevel === "debug" || level === "info";
    }

    function authLog(level, step, details) {
      if (!shouldLog(level)) {
        return;
      }
      if (level === "info") {
        runtime.infoLogLast = runtime.infoLogLast || {};
        var dedupeKey = step + ":" + ((details && details.reason) || "");
        var loggedAt = runtime.infoLogLast[dedupeKey] || 0;
        var current = Date.now();
        if (current - loggedAt < 5000) {
          return;
        }
        runtime.infoLogLast[dedupeKey] = current;
      }
      var writer = level === "info" && console.info ? console.info : console.log;
      writer.call(console, "[CustomerAuthV2]", step, details || {});
    }

    function authDebugSnapshot(extra) {
      var snapshot = {
        path: location.pathname,
        search: location.search,
        flow: getFlow(),
        isShopifyCustomer: CONFIG.isShopifyCustomer,
        hasHintCookie: hasHintCookie(),
        explicitLogout: hasExplicitLogout(),
        isLogoutPage: isLogoutPage(),
        isShopifyAuthPage: isShopifyAuthPage(),
        isSessionSyncPage: isSessionSyncPage(),
        hasKeycloakConfig: hasRequiredKeycloakConfig(),
        hasGsiConfig: hasGsiConfig(),
        hintProbeStatus: sessionStorage.getItem(KEY.hintProbeStatus),
        keycloakSessionState: !!getSessionState()
      };
      if (extra) {
        Object.keys(extra).forEach(function (key) {
          snapshot[key] = extra[key];
        });
      }
      return snapshot;
    }

    function debugDecision(step, details) {
      authLog("debug", step, details || {});
    }

    function infoDecision(step, details) {
      authLog("info", step, details || {});
    }

    function now() {
      return Date.now();
    }

    function setFlow(flow) {
      debugDecision("flow:set", {
        from: getFlow(),
        to: flow,
        reason: "auth state transition"
      });
      sessionStorage.setItem(KEY.flow, flow);
    }

    function getFlow() {
      return sessionStorage.getItem(KEY.flow) || FLOW.IDLE;
    }

    function clearFlow() {
      debugDecision("flow:clear", {
        from: getFlow(),
        reason: "auth state completed or reset"
      });
      sessionStorage.removeItem(KEY.flow);
    }

    function isAppWebView() {
      return /Hover(?: X1)?\/([\d.]+)/i.test(window.navigator.userAgent || "");
    }

    function isLogoutPage() {
      return (
        location.pathname.indexOf("/account/logout") !== -1 ||
        location.pathname.indexOf("/customer_authentication/logout") !== -1
      );
    }

    function isShopifyAuthPage() {
      return (
        location.pathname.indexOf("/customer_authentication/login") !== -1 ||
        location.pathname.indexOf("/customer_authentication/logout") !== -1
      );
    }

    function isSessionSyncPage() {
      return location.pathname.indexOf(CONFIG.sessionSyncPath) !== -1;
    }

    function hasRequiredKeycloakConfig() {
      return !!(CONFIG.authBaseUrl && CONFIG.realm && CONFIG.oidcClientId);
    }

    function hasGsiConfig() {
      return !!(CONFIG.authBaseUrl && CONFIG.realm && CONFIG.googleClientId && CONFIG.googleTarget);
    }

    function getRootDomain() {
      var hostname = window.location.hostname;
      if (hostname === "localhost" || /^[0-9.]+$/.test(hostname)) {
        return hostname;
      }
      if (hostname.indexOf(".myshopify.com") !== -1) {
        return hostname;
      }
      var parts = hostname.split(".");
      return "." + parts.slice(-2).join(".");
    }

    function getCookie(name) {
      var match = document.cookie.match(new RegExp("(^| )" + name + "=([^;]+)"));
      return match ? decodeURIComponent(match[2]) : null;
    }

    function setHintCookie() {
      var secure = location.protocol === "https:" ? "; secure" : "";
      document.cookie = "KC_LOGGED_IN=1; path=/; domain=" + getRootDomain() + "; max-age=" + (30 * 24 * 60 * 60) + "; samesite=lax" + secure;
    }

    function clearHintCookie() {
      var domain = getRootDomain();
      document.cookie = "KC_LOGGED_IN=; path=/; domain=" + domain + "; max-age=0; expires=Thu, 01 Jan 1970 00:00:00 GMT";
      document.cookie = "KC_LOGGED_IN=; path=/; max-age=0; expires=Thu, 01 Jan 1970 00:00:00 GMT";
    }

    function hasHintCookie() {
      return getCookie("KC_LOGGED_IN") === "1";
    }

    function getSessionState() {
      return localStorage.getItem(KEY.sessionState);
    }

    function setSessionState(value) {
      if (value) {
        localStorage.setItem(KEY.sessionState, value);
      }
    }

    function clearSessionState() {
      localStorage.removeItem(KEY.sessionState);
    }

    function markExplicitLogout() {
      infoDecision("logout:explicit", {
        reason: "current path is a logout page; suppress automatic login in this tab"
      });
      setFlow(FLOW.EXPLICIT_LOGOUT);
      sessionStorage.setItem(KEY.explicitLogout, "true");
      sessionStorage.removeItem(KEY.hintProbeStatus);
      clearHintCookie();
      clearSessionState();
    }

    function hasExplicitLogout() {
      return sessionStorage.getItem(KEY.explicitLogout) === "true";
    }

    function isLifecycleReconcile(reason) {
      return reason === "dom_ready" ||
        reason === "snippet_exec" ||
        reason === "pageshow" ||
        reason === "visibilitychange" ||
        reason === "focus";
    }

    function logPageviewCheckDecision(reason, willCheck, method, decisionReason) {
      if (!isLifecycleReconcile(reason)) {
        return;
      }
      infoDecision("pageview:session_check_decision", {
        trigger: reason || "unknown",
        willCheck: !!willCheck,
        method: method || "none",
        reason: decisionReason,
        isShopifyCustomer: CONFIG.isShopifyCustomer,
        hasHintCookie: hasHintCookie(),
        flow: getFlow()
      });
    }

    function currentRelativeUrl() {
      return location.pathname + location.search;
    }

    function currentRelativeUrlWithoutOidcParams() {
      var url = new URL(location.href);
      [
        "code",
        "state",
        "session_state",
        "iss",
        "error",
        "error_description",
        "error_uri"
      ].forEach(function (name) {
        url.searchParams.delete(name);
      });
      return safeRelativeTarget(url.pathname + url.search);
    }

    function safeRelativeTarget(value) {
      if (!value || value.charAt(0) !== "/" || value.indexOf("//") === 0) {
        return "/";
      }
      return value;
    }

    function extractSidFromUrl() {
      var sid = null;
      if (location.hash && location.hash.indexOf("sid=") !== -1) {
        sid = new URLSearchParams(location.hash.replace(/^#/, "")).get("sid");
      }
      if (!sid) {
        sid = new URLSearchParams(location.search).get("sid");
      }
      return sid;
    }

    function cleanSidFromUrl() {
      var url = new URL(location.href);
      var changed = false;
      if (url.searchParams.has("sid")) {
        url.searchParams.delete("sid");
        changed = true;
      }
      if (url.hash && url.hash.indexOf("sid=") !== -1) {
        url.hash = "";
        changed = true;
      }
      if (changed) {
        history.replaceState(null, "", url.pathname + url.search + url.hash);
      }
    }

    function noteSuccessfulSessionReturn() {
      var sid = extractSidFromUrl();
      if (sid) {
        infoDecision("session:return:sid", {
          reason: "session-sync returned a signed sid; store session hint and clean URL"
        });
        localStorage.setItem("zz_session_id", sid);
        setHintCookie();
        sessionStorage.setItem(KEY.hintProbeStatus, "done_with_session");
        setFlow(FLOW.DONE);
        cleanSidFromUrl();
        return true;
      }
      return false;
    }

    function isReturnedSuccessfulEagerProbe() {
      var params = new URLSearchParams(location.search);
      var state = params.get("state") || "";
      return !!params.get("code") && state.indexOf("PROBE_") === 0;
    }

    function consumeReturnedSuccessfulEagerProbe() {
      if (!isReturnedSuccessfulEagerProbe()) {
        return false;
      }
      infoDecision("probe:success:return", {
        reason: "Keycloak prompt=none returned code with PROBE state; Shopify session still needs login handoff",
        returnTo: currentRelativeUrlWithoutOidcParams()
      });
      setHintCookie();
      sessionStorage.setItem(KEY.hintProbeStatus, "done_with_session");
      clearSessionState();

      if (!canSessionNavigate()) {
        infoDecision("probe:success:handoff_blocked", {
          reason: "navigation lock or GSI flow is active",
          flow: getFlow()
        });
        return true;
      }

      navigate(shopifyLoginUrl(), FLOW.SESSION_SYNC_HANDOFF, true);
      return true;
    }

    function isNavigationLocked() {
      var flow = getFlow();
      return flow === FLOW.EXPLICIT_LOGOUT || flow === FLOW.SESSION_SYNC_HANDOFF || flow === FLOW.GSI_HANDOFF;
    }

    function isGsiFlow() {
      var flow = getFlow();
      return flow === FLOW.GSI_PROMPTING || flow === FLOW.GSI_API_LOGIN || flow === FLOW.GSI_HANDOFF;
    }

    function canSessionNavigate() {
      return !isNavigationLocked() && !isGsiFlow();
    }

    function canGsiNavigate() {
      var flow = getFlow();
      return !isNavigationLocked() && (flow === FLOW.IDLE || flow === FLOW.GSI_PROMPTING || flow === FLOW.GSI_API_LOGIN || flow === FLOW.DONE);
    }

    function navigate(url, nextFlow, replace) {
      setFlow(nextFlow);
      infoDecision("navigate", {
        reason: "auth flow requires browser navigation",
        nextFlow: nextFlow,
        replace: !!replace,
        url: url
      });
      if (replace) {
        location.replace(url);
      } else {
        location.href = url;
      }
    }

    function handleSessionSyncBouncePage() {
      if (!isSessionSyncPage()) {
        return false;
      }
      infoDecision("session_sync:bounce", {
        reason: "session-sync bounce page detected; consume sid and return to safe target"
      });
      noteSuccessfulSessionReturn();
      var target = new URLSearchParams(location.search).get("target");
      navigate(safeRelativeTarget(target), FLOW.DONE, true);
      return true;
    }

    function consumeReturnedFailedEagerProbe() {
      if (sessionStorage.getItem(KEY.hintProbeStatus) !== "running") {
        return false;
      }
      if (noteSuccessfulSessionReturn()) {
        return false;
      }
      infoDecision("probe:failed:return", {
        reason: "eager probe returned without sid/code success; treat hint as stale"
      });
      sessionStorage.setItem(KEY.hintProbeStatus, "done_no_session");
      clearHintCookie();
      clearSessionState();
      clearFlow();
      return true;
    }

    function oidcAuthBaseUrl() {
      return CONFIG.authBaseUrl + "/realms/" + encodeURIComponent(CONFIG.realm) + "/protocol/openid-connect/auth";
    }

    function buildEagerProbeUrl() {
      var state = "PROBE_" + Math.random().toString(36).substring(2) + now().toString(36);
      return (
        oidcAuthBaseUrl() +
        "?client_id=" + encodeURIComponent(CONFIG.oidcClientId) +
        "&redirect_uri=" + encodeURIComponent(location.href) +
        "&response_type=code" +
        "&scope=openid" +
        "&prompt=none" +
        "&state=" + encodeURIComponent(state)
      );
    }

    function shouldRunEagerProbe() {
      if (!hasRequiredKeycloakConfig() || !hasHintCookie() || CONFIG.isShopifyCustomer) {
        return false;
      }
      var last = parseInt(sessionStorage.getItem(KEY.legacyEagerAt) || "0", 10);
      return !last || now() - last > CONFIG.eagerCooldownMs;
    }

    function runEagerProbe() {
      if (!canSessionNavigate()) {
        debugDecision("probe:eager:skip", {
          reason: "session navigation is blocked by current flow",
          flow: getFlow()
        });
        return false;
      }
      infoDecision("probe:eager:start", {
        reason: "anonymous user has KC_LOGGED_IN hint; verify Keycloak session with top-level prompt=none",
        realm: CONFIG.realm,
        clientId: CONFIG.oidcClientId,
        returnTo: currentRelativeUrlWithoutOidcParams()
      });
      sessionStorage.setItem(KEY.legacyEagerAt, String(now()));
      sessionStorage.setItem(KEY.hintProbeStatus, "running");
      clearSessionState();
      navigate(buildEagerProbeUrl(), FLOW.SESSION_CHECK_RUNNING, false);
      return true;
    }

    function buildIframeProbeUrl() {
      return (
        oidcAuthBaseUrl() +
        "?client_id=" + encodeURIComponent(CONFIG.oidcClientId) +
        "&redirect_uri=" + encodeURIComponent(CONFIG.sessionCheckRedirectUri) +
        "&response_type=code%20id_token" +
        "&scope=openid" +
        "&nonce=" + encodeURIComponent(Math.random().toString(36).substring(2) + now().toString(36)) +
        "&prompt=none"
      );
    }

    function shouldRunIframeCheck(forceAnonymousCheck) {
      if (!hasRequiredKeycloakConfig()) {
        return false;
      }
      if (CONFIG.isShopifyCustomer) {
        return true;
      }
      if (forceAnonymousCheck && !isGsiFlow()) {
        return true;
      }
      return hasHintCookie() && !isGsiFlow();
    }

    function runIframeSessionCheck(forceAnonymousCheck) {
      if (!shouldRunIframeCheck(!!forceAnonymousCheck)) {
        debugDecision("probe:iframe:skip", {
          reason: "iframe session check is not applicable for the current state",
          forceAnonymousCheck: !!forceAnonymousCheck,
          snapshot: authDebugSnapshot()
        });
        return false;
      }
      if (!document.body) {
        debugDecision("probe:iframe:skip", {
          reason: "document.body is not available yet"
        });
        return false;
      }

      var last = parseInt(sessionStorage.getItem(KEY.legacyIframeAt) || "0", 10);
      if (last && now() - last < CONFIG.iframeCooldownMs) {
        debugDecision("probe:iframe:skip", {
          reason: "iframe cooldown is active",
          cooldownMs: CONFIG.iframeCooldownMs,
          ageMs: now() - last
        });
        return false;
      }

      debugDecision("probe:iframe:start", {
        reason: CONFIG.isShopifyCustomer
          ? "Shopify customer is logged in; monitor Keycloak session"
          : (forceAnonymousCheck
            ? "anonymous lifecycle reconcile checks Keycloak before GSI fallback"
            : "anonymous user has hint; verify Keycloak session before GSI"),
        realm: CONFIG.realm,
        clientId: CONFIG.oidcClientId,
        forceAnonymousCheck: !!forceAnonymousCheck
      });
      sessionStorage.setItem(KEY.legacyIframeAt, String(now()));
      if (!CONFIG.isShopifyCustomer) {
        setFlow(FLOW.SESSION_CHECK_RUNNING);
      }

      var frameId = "auth-probe-frame-v4";
      var existing = document.getElementById(frameId);
      if (existing) {
        existing.remove();
      }

      var iframe = document.createElement("iframe");
      iframe.id = frameId;
      iframe.style.display = "none";
      iframe.src = buildIframeProbeUrl();
      document.body.appendChild(iframe);

      setTimeout(function () {
        var el = document.getElementById(frameId);
        if (el) {
          el.remove();
        }
      }, CONFIG.iframeTimeoutMs);

      return true;
    }

    function shopifyLoginUrl() {
      return CONFIG.shopifyLoginUri + "?return_to=" + encodeURIComponent(currentRelativeUrlWithoutOidcParams());
    }

    function shopifyLogoutUrl() {
      return CONFIG.shopifyLogoutUri + "?return_to=" + encodeURIComponent(currentRelativeUrl());
    }

    function handleActiveSession(data) {
      infoDecision("session:active", {
        reason: CONFIG.isShopifyCustomer
          ? "Keycloak session is active while Shopify user is logged in"
          : "Keycloak session is active for anonymous Shopify user; Shopify login handoff required",
        hasUserId: !!data.userId,
        hasSessionState: !!data.session_state
      });
      setHintCookie();

      window.__ZZ_ANALYTICS_CONTEXT__ = window.__ZZ_ANALYTICS_CONTEXT__ || {};
      if (data.userId) {
        window.__ZZ_ANALYTICS_CONTEXT__.huid = data.userId;
      }

      if (!CONFIG.isShopifyCustomer) {
        if (!canSessionNavigate()) {
          debugDecision("session:active:handoff_blocked", {
            reason: "active session result arrived while another auth flow owns navigation",
            flow: getFlow()
          });
          return;
        }
        clearSessionState();
        navigate(shopifyLoginUrl(), FLOW.SESSION_SYNC_HANDOFF, false);
        return;
      }

      var incomingState = data.session_state;
      var localState = getSessionState();
      if (!localState) {
        debugDecision("session:state:init", {
          reason: "store first observed Keycloak session_state for account switch monitoring"
        });
        setSessionState(incomingState);
        setFlow(FLOW.SHOPIFY_MONITORING);
        return;
      }
      if (incomingState && incomingState !== localState) {
        if (!canSessionNavigate()) {
          debugDecision("session:state:mismatch_blocked", {
            reason: "account switch detected but navigation is blocked",
            flow: getFlow()
          });
          return;
        }
        infoDecision("session:state:mismatch", {
          reason: "Keycloak session_state changed; logout Shopify session and resync"
        });
        clearSessionState();
        sessionStorage.removeItem(KEY.legacyEagerAt);
        navigate(shopifyLogoutUrl(), FLOW.SESSION_SYNC_HANDOFF, false);
      }
    }

    function handleInactiveSession() {
      infoDecision("session:inactive", {
        reason: CONFIG.isShopifyCustomer
          ? "Keycloak session is inactive while Shopify user is logged in"
          : "Keycloak session is inactive for anonymous user; stale hint should be cleared",
        isShopifyCustomer: CONFIG.isShopifyCustomer
      });
      if (CONFIG.isShopifyCustomer) {
        if (!canSessionNavigate()) {
          debugDecision("session:inactive:logout_blocked", {
            reason: "logout navigation is blocked by current flow",
            flow: getFlow()
          });
          return;
        }
        clearHintCookie();
        clearSessionState();
        navigate(shopifyLogoutUrl(), FLOW.SESSION_SYNC_HANDOFF, false);
        return;
      }

      if (hasHintCookie()) {
        infoDecision("hint:clear", {
          reason: "Keycloak iframe returned inactive; KC_LOGGED_IN hint is stale"
        });
        clearHintCookie();
        clearSessionState();
      }
      sessionStorage.setItem(KEY.hintProbeStatus, "done_no_session");
      clearFlow();
      maybeRunGsi();
    }

    function handleIframeMessage(event) {
      if (!event.data || event.data.type !== "KEYCLOAK_SESSION_STATUS") {
        return;
      }
      if (event.origin !== new URL(CONFIG.sessionCheckRedirectUri).origin) {
        debugDecision("iframe:message:ignored", {
          reason: "Keycloak session status payload origin does not match session check origin",
          origin: event.origin
        });
        return;
      }

      debugDecision("iframe:message:accepted", {
        reason: "session check iframe returned status",
        status: event.data.status,
        hasSessionState: !!event.data.session_state,
        hasUserId: !!event.data.userId
      });
      if (event.data.status === "active") {
        handleActiveSession(event.data);
      } else {
        handleInactiveSession();
      }
    }

    function shouldRunGsi() {
      if (!hasGsiConfig()) {
        debugDecision("gsi:skip", { reason: "missing Google One Tap config" });
        return false;
      }
      if (CONFIG.isShopifyCustomer) {
        debugDecision("gsi:skip", { reason: "Shopify customer is already logged in" });
        return false;
      }
      if (hasExplicitLogout()) {
        debugDecision("gsi:skip", { reason: "explicit logout marker suppresses automatic login" });
        return false;
      }
      if (isLogoutPage() || isShopifyAuthPage() || isSessionSyncPage()) {
        debugDecision("gsi:skip", { reason: "current page is reserved for auth/logout/session-sync handling" });
        return false;
      }
      if (hasHintCookie()) {
        debugDecision("gsi:skip", { reason: "KC_LOGGED_IN hint exists; session-sync has priority" });
        return false;
      }
      if (isNavigationLocked()) {
        debugDecision("gsi:skip", { reason: "navigation is locked by current auth flow", flow: getFlow() });
        return false;
      }
      if (getFlow() === FLOW.SESSION_CHECK_RUNNING || getFlow() === FLOW.SESSION_SYNC_HANDOFF) {
        debugDecision("gsi:skip", { reason: "session-sync is running or handing off", flow: getFlow() });
        return false;
      }

      var lastPrompt = parseInt(sessionStorage.getItem(KEY.lastGsiPromptAt) || "0", 10);
      if (lastPrompt && now() - lastPrompt < CONFIG.gsiCooldownMs) {
        debugDecision("gsi:skip", {
          reason: "GSI prompt cooldown is active",
          cooldownMs: CONFIG.gsiCooldownMs,
          ageMs: now() - lastPrompt
        });
        return false;
      }
      return true;
    }

    function loadGoogleIdentityScript(callback) {
      if (window.google && google.accounts && google.accounts.id) {
        callback();
        return;
      }

      var existing = document.querySelector("script[data-google-gsi]");
      if (existing) {
        existing.addEventListener("load", callback);
        return;
      }

      var script = document.createElement("script");
      script.src = "https://accounts.google.com/gsi/client";
      script.async = true;
      script.defer = true;
      script.setAttribute("data-google-gsi", "true");
      script.onload = callback;
      document.head.appendChild(script);
    }

    function googleOneTapApiBase() {
      return CONFIG.authBaseUrl + "/realms/" + encodeURIComponent(CONFIG.realm) + "/google-one-tap";
    }

    function clearGsiFlow() {
      if (getFlow() === FLOW.GSI_PROMPTING || getFlow() === FLOW.GSI_API_LOGIN) {
        debugDecision("gsi:flow:clear", {
          reason: "GSI flow did not continue to launch handoff",
          flow: getFlow()
        });
        clearFlow();
      }
    }

    function handleGoogleCredential(response) {
      if (!response || !response.credential) {
        debugDecision("gsi:credential:missing", {
          reason: "Google callback did not include credential"
        });
        clearGsiFlow();
        return;
      }
      if (!canGsiNavigate()) {
        debugDecision("gsi:credential:ignored", {
          reason: "Google credential arrived while navigation is locked",
          flow: getFlow()
        });
        return;
      }

      infoDecision("gsi:api_login:start", {
        reason: "Google credential received; exchange through Keycloak One Tap API",
        target: CONFIG.googleTarget,
        returnTo: CONFIG.returnTo
      });
      setFlow(FLOW.GSI_API_LOGIN);

      var apiBase = googleOneTapApiBase();
      var initUrl = new URL(apiBase + "/init");
      initUrl.searchParams.set("target", CONFIG.googleTarget);
      initUrl.searchParams.set("return_to", CONFIG.returnTo);

      fetch(initUrl.toString(), {
        method: "GET",
        credentials: "include"
      })
        .then(function (response) {
          if (!response.ok) {
            throw new Error("init_failed");
          }
          return response.json();
        })
        .then(function (initData) {
          return fetch(apiBase + "/login", {
            method: "POST",
            credentials: "include",
            headers: {
              "Content-Type": "application/json"
            },
            body: JSON.stringify({
              credential: response.credential,
              target: CONFIG.googleTarget,
              returnTo: CONFIG.returnTo,
              state: initData.state,
              mode: "json"
            })
          });
        })
        .then(function (loginResponse) {
          if (!loginResponse.ok) {
            throw new Error("login_failed");
          }
          return loginResponse.json();
        })
        .then(function (loginData) {
          if (loginData && loginData.launchUrl && canGsiNavigate()) {
            infoDecision("gsi:handoff", {
              reason: "Keycloak One Tap API returned launch URL; navigate to complete Keycloak and Shopify sessions"
            });
            setFlow(FLOW.GSI_HANDOFF);
            location.assign(loginData.launchUrl);
            return;
          }
          clearGsiFlow();
        })
        .catch(function (error) {
          infoDecision("gsi:api_login:failed", {
            reason: "Keycloak One Tap API login failed",
            error: error && error.message ? error.message : String(error)
          });
          clearGsiFlow();
        });
    }

    function maybeRunGsi() {
      if (!shouldRunGsi()) {
        return false;
      }

      sessionStorage.setItem(KEY.lastGsiPromptAt, String(now()));
      setFlow(FLOW.GSI_PROMPTING);
      infoDecision("gsi:prompt:start", {
        reason: "no reusable Keycloak session was hinted/found; start Google One Tap fallback",
        target: CONFIG.googleTarget
      });

      loadGoogleIdentityScript(function () {
        if (!window.google || !google.accounts || !google.accounts.id) {
          infoDecision("gsi:script:unavailable", {
            reason: "Google Identity Services script did not expose google.accounts.id"
          });
          clearGsiFlow();
          return;
        }

        google.accounts.id.initialize({
          client_id: CONFIG.googleClientId,
          callback: handleGoogleCredential,
          auto_select: false,
          cancel_on_tap_outside: true
        });

        google.accounts.id.prompt(function (notification) {
          if (!notification) return;

          var notDisplayed = notification.isNotDisplayed && notification.isNotDisplayed();
          var skipped = notification.isSkippedMoment && notification.isSkippedMoment();
          var dismissed = notification.isDismissedMoment && notification.isDismissedMoment();

          if (notDisplayed || skipped || dismissed) {
            infoDecision("gsi:prompt:closed", {
              reason: "Google One Tap prompt was not displayed, skipped, or dismissed",
              notDisplayed: !!notDisplayed,
              skipped: !!skipped,
              dismissed: !!dismissed
            });
            clearGsiFlow();
          }
        });
      });

      return true;
    }

    function scheduleReconcile(reason) {
      runtime.pendingReason = reason || "unknown";
      if (runtime.reconcileScheduled) {
        debugDecision("reconcile:schedule:coalesced", {
          reason: "reconcile is already scheduled; latest reason will be used",
          latestReason: runtime.pendingReason
        });
        return;
      }
      debugDecision("reconcile:schedule", {
        reason: "auth lifecycle event requested state reconciliation",
        trigger: runtime.pendingReason
      });
      runtime.reconcileScheduled = true;
      setTimeout(function () {
        runtime.reconcileScheduled = false;
        if (runtime.reconcileAuthState) {
          runtime.reconcileAuthState(runtime.pendingReason);
        }
      }, 0);
    }

    function registerGlobalListenersOnce() {
      if (runtime.listenersRegistered) {
        debugDecision("listeners:skip", {
          reason: "global auth listeners are already registered"
        });
        return;
      }
      runtime.listenersRegistered = true;
      debugDecision("listeners:register", {
        reason: "register global auth lifecycle listeners once"
      });

      window.addEventListener("message", function (event) {
        var currentRuntime = window.__authSessionSync;
        if (currentRuntime && currentRuntime.handleIframeMessage) {
          currentRuntime.handleIframeMessage(event);
        }
      });

      document.addEventListener("visibilitychange", function () {
        if (!document.hidden && window.__authSessionSync && window.__authSessionSync.scheduleReconcile) {
          window.__authSessionSync.scheduleReconcile("visibilitychange");
        }
      });

      window.addEventListener("focus", function () {
        if (window.__authSessionSync && window.__authSessionSync.scheduleReconcile) {
          window.__authSessionSync.scheduleReconcile("focus");
        }
      });

      window.addEventListener("pageshow", function () {
        if (window.__authSessionSync && window.__authSessionSync.scheduleReconcile) {
          window.__authSessionSync.scheduleReconcile("pageshow");
        }
      });
    }

    function reconcileAuthState(reason) {
      debugDecision("reconcile:start", authDebugSnapshot({
        reason: "evaluate current Shopify, Keycloak hint, page, and flow state",
        trigger: reason || "unknown"
      }));

      if (isAppWebView()) {
        logPageviewCheckDecision(reason, false, "none", "running inside Hover app WebView");
        debugDecision("reconcile:skip", { reason: "running inside Hover app WebView" });
        return;
      }

      if (!hasRequiredKeycloakConfig()) {
        logPageviewCheckDecision(reason, false, "none", "missing required Keycloak config");
        infoDecision("reconcile:skip", { reason: "missing required Keycloak config" });
        return;
      }

      if (isLogoutPage()) {
        logPageviewCheckDecision(reason, false, "none", "logout page owns auth state");
        infoDecision("reconcile:logout_page", {
          reason: "logout page owns this navigation; clear auth hints"
        });
        markExplicitLogout();
        return;
      }

      if (hasExplicitLogout()) {
        logPageviewCheckDecision(reason, false, "none", "explicit logout marker is set in this tab");
        debugDecision("reconcile:skip", {
          reason: "explicit logout marker is set in this tab"
        });
        return;
      }

      if (handleSessionSyncBouncePage()) {
        logPageviewCheckDecision(reason, false, "bounce", "session-sync bounce page handles return target");
        return;
      }

      if (isShopifyAuthPage()) {
        logPageviewCheckDecision(reason, false, "none", "Shopify auth page must not be interrupted");
        debugDecision("reconcile:skip", {
          reason: "Shopify auth page must not be interrupted"
        });
        return;
      }

      noteSuccessfulSessionReturn();
      if (consumeReturnedSuccessfulEagerProbe()) {
        return;
      }
      consumeReturnedFailedEagerProbe();

      if (CONFIG.isShopifyCustomer) {
        logPageviewCheckDecision(reason, true, "iframe", "Shopify customer is logged in; monitor Keycloak session");
        infoDecision("reconcile:branch", {
          reason: "Shopify customer is logged in; monitor Keycloak session and account switch"
        });
        setHintCookie();
        setFlow(FLOW.SHOPIFY_MONITORING);
        runIframeSessionCheck();
        return;
      }

      if (hasHintCookie()) {
        logPageviewCheckDecision(reason, true, shouldRunEagerProbe() ? "eager" : "iframe", "anonymous user has KC_LOGGED_IN hint");
        infoDecision("reconcile:branch", {
          reason: "anonymous Shopify user has KC_LOGGED_IN hint; session-sync has priority over GSI"
        });
        if (shouldRunEagerProbe() && runEagerProbe()) {
          return;
        }
        runIframeSessionCheck();
        return;
      }

      if (isLifecycleReconcile(reason)) {
        logPageviewCheckDecision(reason, true, "iframe", "anonymous user has no Keycloak hint; lifecycle discovery checks Keycloak before GSI");
        infoDecision("reconcile:branch", {
          reason: "anonymous Shopify user has no Keycloak hint; lifecycle check verifies Keycloak before GSI fallback",
          trigger: reason || "unknown"
        });
        if (runIframeSessionCheck(true)) {
          return;
        }
      }

      infoDecision("reconcile:branch", {
        reason: "anonymous Shopify user has no Keycloak hint; evaluate Google One Tap fallback"
      });
      maybeRunGsi();
    }

    runtime.handleIframeMessage = handleIframeMessage;
    runtime.reconcileAuthState = reconcileAuthState;
    runtime.scheduleReconcile = scheduleReconcile;
    registerGlobalListenersOnce();

    if (document.readyState === "loading") {
      if (!runtime.domReadyReconcileRegistered) {
        runtime.domReadyReconcileRegistered = true;
        document.addEventListener("DOMContentLoaded", function () {
          if (window.__authSessionSync && window.__authSessionSync.scheduleReconcile) {
            window.__authSessionSync.scheduleReconcile("dom_ready");
          }
        });
      }
    } else {
      scheduleReconcile("snippet_exec");
    }
  })();
</script>
