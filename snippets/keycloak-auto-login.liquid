{% comment %}
  Snippet: keycloak-auto-login.liquid
  Purpose: Automatically redirect anonymous users to Keycloak to check for an active session.
{% endcomment %}

<script>
  window.isShopifyUserLoggedIn = {% if customer %}true{% else %}false{% endif %};
</script>
<script>
  /**
   * Shopify Auto-Login (Probe Strategy)
   *
   * Logic:
   * 1. Check if user is already logged in (liquid 'customer' check).
   * 2. If 'Anonymous', check 'keycloak_checked' flag in sessionStorage.
   * 3. If NOT checked, set flag and redirect to Keycloak Probe URL.
   *    - prompt=none (Silent check)
   *    - state=PROBE (Signal to Filter)
   */
  (function () {
    // =========================================================================
    // DUPLICATE INITIALIZATION GUARD
    // =========================================================================
    // Prevent duplicate event listeners if this script is loaded multiple times
    // (e.g., in SPA navigation or multiple Liquid template includes)
    if (window.__kcAutoLoginInitialized) {
      return;
    }
    window.__kcAutoLoginInitialized = true;

    // =========================================================================
    // EXPLICIT LOGOUT DETECTION
    // =========================================================================
    // If user is on a logout page, clear the session token and set a flag
    // to prevent auto-login in this browser session.
    var isLogoutPage =
      window.location.pathname.includes('/account/logout') ||
      window.location.pathname.includes('/customer_authentication/logout');

    if (isLogoutPage) {
      console.log('[AutoLogin] Logout page detected. Clearing session token.');
      localStorage.removeItem('zz_session_id');
      sessionStorage.setItem('explicit_logout', 'true');
      return; // Don't execute any other logic on logout page
    }

    // If user explicitly logged out in this session, don't auto-login
    if (sessionStorage.getItem('explicit_logout')) {
      console.log('[AutoLogin] User explicitly logged out. Skipping auto-login.');
      return;
    }

    // 0. Surgical Cleanup & Session Persistence
    // -------------------------------------------------------------------------
    // Capture 'sid' from URL, save to localStorage for device-aware logout,
    // and remove it from URL without reloading.
    var url = new URL(window.location.href);
    var sid = url.searchParams.get('sid');
    if (sid) {
      console.log('[AutoLogin] Captured session ID:', sid);
      localStorage.setItem('zz_session_id', sid);
      url.searchParams.delete('sid');
      window.history.replaceState(null, null, url.pathname + url.search + url.hash);
    }
    // 1. Shopify User Status Check
    // -------------------------------------------------------------------------
    // IMPORTANT: When pasting this into Shopify 'keycloak-auto-login.liquid',
    // YOU MUST REPLACE THE LINE BELOW:
    //
    // var isShopifyUserLoggedIn = window.isShopifyUserLoggedIn || false;
    //
    // ...WITH THIS LIQUID LOGIC:
    //
    // var isShopifyUserLoggedIn = {% if customer %}true{% else %}false{% endif %};
    // -------------------------------------------------------------------------

    // Placeholder for local JS validity (Replace this in Shopify)
    var isShopifyUserLoggedIn = window.isShopifyUserLoggedIn || false;

    // =========================================================================
    // AUTO-LOGOUT SYNC: Check if Keycloak session is still valid
    // =========================================================================
    if (isShopifyUserLoggedIn) {
      console.log('[AutoLogin] User is logged in. Enabling session sync.');

      var storedSid = localStorage.getItem('zz_session_id');
      if (storedSid) {
        // Configuration - REPLACE THESE
        var KEYCLOAK_SESSION_CHECK_URL =
          'https://auth-test.zerozerorobotics.com/realms/vcopter/hoverair/session-status';

        function checkSessionStatus() {
          console.log('[SessionSync] Checking Keycloak session status...');
          fetch(KEYCLOAK_SESSION_CHECK_URL + '?token=' + encodeURIComponent(storedSid), {
            method: 'GET',
            credentials: 'omit', // Don't send cookies
          })
            .then(function (response) {
              return response.json();
            })
            .then(function (data) {
              if (data.active === false) {
                console.log('[SessionSync] Keycloak session inactive. Triggering logout.');
                // Clear local storage before logout
                localStorage.removeItem('zz_session_id');
                window.location.href = '/account/logout';
              } else {
                console.log('[SessionSync] Keycloak session is active.');
              }
            })
            .catch(function (error) {
              // Silently ignore errors (don't logout on network failure)
              console.warn('[SessionSync] Check failed (network error):', error);
            });
        }

        // Trigger on tab focus (visibilitychange)
        document.addEventListener('visibilitychange', function () {
          if (!document.hidden) {
            checkSessionStatus();
          }
        });

        // Also check on initial page load
        checkSessionStatus();
      }

      return;
    }

    // 2. Loop Prevention Check
    var CHECK_FLAG = 'keycloak_checked';
    var hasChecked = sessionStorage.getItem(CHECK_FLAG);

    if (hasChecked) {
      console.log('[AutoLogin] Already checked in this session (Probe sent). Skipping.');
      return;
    }

    // Configuration - REPLACE THESE
    var KEYCLOAK_AUTH_URL = 'https://auth-test.zerozerorobotics.com/realms/vcopter/protocol/openid-connect/auth';
    var CLIENT_ID = window.location.hostname === 'latentseek.com' ? 'shopify-fake-store-central' : 'shopify-fake-store';
    // The callback must be whitelisted in Keycloak, but it won't actually handle the login
    // The Filter will intercept before this URL is hit.
    var CALLBACK_URL = window.location.href;

    // 3. Execution: Dispatch Probe
    console.log('[AutoLogin] dispatching Probe...');

    // Set flag to prevent loop
    sessionStorage.setItem(CHECK_FLAG, 'true');

    // Construct Probe URL
    var probeUrl =
      KEYCLOAK_AUTH_URL +
      '?client_id=' +
      encodeURIComponent(CLIENT_ID) +
      '&redirect_uri=' +
      encodeURIComponent(CALLBACK_URL) +
      '&response_type=code' +
      '&scope=openid' +
      '&prompt=none' + // CRITICAL: Silent Check
      '&state=PROBE'; // CRITICAL: Signal to Filter

    window.location.href = probeUrl;
  })();
</script>
