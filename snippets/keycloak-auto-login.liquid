{% comment %}
  Snippet: keycloak-auto-login.liquid
  Purpose: Automatically redirect anonymous users to Keycloak to check for an active session.
{% endcomment %}

<script>
  window.isShopifyUserLoggedIn = {% if customer %}true{% else %}false{% endif %};

  window._auth_base_url = 'https://auth-test.zerozerorobotics.com';
  window._auth_realm = 'vcopter';
  window._auth_client_id = window.location.hostname === 'latentseek.com' ? 'shopify-fake-store-central' : 'shopify-fake-store';
  window._auth_debug = true;
</script>
<script>
  /**
   * Shopify Auto-Login (Probe Strategy)
   *
   * Logic:
   * 1. Check if user is already logged in (liquid 'customer' check).
   * 2. If 'Anonymous', check 'keycloak_checked' flag in sessionStorage.
   * 3. If NOT checked, set flag and redirect to Keycloak Probe URL.
   *    - prompt=none (Silent check)
   *    - state=PROBE (Signal to Filter)
   */
  (function () {
    // =========================================================================
    // DUPLICATE INITIALIZATION GUARD
    // =========================================================================
    // Prevent duplicate event listeners if this script is loaded multiple times
    // (e.g., in SPA navigation or multiple Liquid template includes)
    if (window.__kcAutoLoginInitialized) {
      return;
    }
    window.__kcAutoLoginInitialized = true;

    // =========================================================================
    // GLOBAL CONFIGURATION
    // =========================================================================
    var AUTH_BASE_URL = window._auth_base_url;
    var REALM = window._auth_realm;
    var CLIENT_ID = window._auth_client_id;
    if (!AUTH_BASE_URL || !REALM || !CLIENT_ID) {
      console.error('[AutoLogin] Missing Keycloak configuration.');
      return;
    }

    // Derived URLs
    var KEYCLOAK_SESSION_CHECK_URL = AUTH_BASE_URL + '/realms/' + REALM + '/hoverair/session-status';
    var KEYCLOAK_AUTH_URL = AUTH_BASE_URL + '/realms/' + REALM + '/protocol/openid-connect/auth';

    // =========================================================================
    // EXPLICIT LOGOUT DETECTION
    // =========================================================================
    // If user is on a logout page, clear the session token and set a flag
    // to prevent auto-login in this browser session.
    var isLogoutPage =
      window.location.pathname.includes('/account/logout') ||
      window.location.pathname.includes('/customer_authentication/logout');

    if (isLogoutPage) {
      console.log('[AutoLogin] Logout page detected. Clearing session token.');
      localStorage.removeItem('zz_session_id');
      sessionStorage.setItem('explicit_logout', 'true');
      return; // Don't execute any other logic on logout page
    }

    // If user explicitly logged out in this session, don't auto-login
    if (sessionStorage.getItem('explicit_logout')) {
      console.log('[AutoLogin] User explicitly logged out. Skipping auto-login.');
      return;
    }

    // 0. Surgical Cleanup & Session Persistence
    // -------------------------------------------------------------------------
    // Capture 'sid' from URL, save to localStorage for device-aware logout,
    // and remove it from URL without reloading.
    var url = new URL(window.location.href);
    var sid = url.searchParams.get('sid');
    if (sid) {
      console.log('[AutoLogin] Captured session ID:', sid);
      localStorage.setItem('zz_session_id', sid);
      url.searchParams.delete('sid');
      window.history.replaceState(null, null, url.pathname + url.search + url.hash);
    }
    // 1. Shopify User Status Check
    // -------------------------------------------------------------------------
    // IMPORTANT: When pasting this into Shopify 'keycloak-auto-login.liquid',
    // YOU MUST REPLACE THE LINE BELOW:
    //
    // var isShopifyUserLoggedIn = window.isShopifyUserLoggedIn || false;
    //
    // ...WITH THIS LIQUID LOGIC:
    //
    // var isShopifyUserLoggedIn = {% if customer %}true{% else %}false{% endif %};
    // -------------------------------------------------------------------------

    // Placeholder for local JS validity (Replace this in Shopify)
    var isShopifyUserLoggedIn = window.isShopifyUserLoggedIn || false;

    var CHECK_FLAG = 'keycloak_checked';
    var LAST_PROBE_AT_KEY = 'keycloak_last_probe_at';
    var PROBE_COOLDOWN_MS = 2 * 60 * 1000;

    function shouldProbe() {
      if (sessionStorage.getItem('explicit_logout')) {
        return false;
      }
      if (window.location.pathname.includes('/pages/session-sync')) {
        return false;
      }
      var lastProbeAt = parseInt(sessionStorage.getItem(LAST_PROBE_AT_KEY) || '0', 10);
      return !lastProbeAt || Date.now() - lastProbeAt >= PROBE_COOLDOWN_MS;
    }

    function markProbe() {
      sessionStorage.setItem(CHECK_FLAG, 'true');
      sessionStorage.setItem(LAST_PROBE_AT_KEY, String(Date.now()));
    }

    function dispatchProbe() {
      if (!shouldProbe()) {
        return;
      }
      markProbe();

      // Use current page as redirect_uri - Keycloak will return to this exact URL
      // This requires wildcard redirect_uri in Keycloak client config (e.g., https://store.hoverair.com/*)
      var callbackUrl = window.location.href;
      var probeUrl =
        KEYCLOAK_AUTH_URL +
        '?client_id=' +
        encodeURIComponent(CLIENT_ID) +
        '&redirect_uri=' +
        encodeURIComponent(callbackUrl) +
        '&response_type=code' +
        '&scope=openid' +
        '&prompt=none' + // CRITICAL: Silent Check
        '&state=PROBE'; // CRITICAL: Signal to Filter

      window.location.href = probeUrl;
    }

    // =========================================================================
    // AUTO-LOGOUT SYNC: Check if Keycloak session is still valid
    // =========================================================================
    if (isShopifyUserLoggedIn) {
      console.log('[AutoLogin] User is logged in. Enabling session sync.');

      var storedSid = localStorage.getItem('zz_session_id');
      if (storedSid) {
        function checkSessionStatus() {
          console.log('[SessionSync] Checking Keycloak session status...');
          fetch(KEYCLOAK_SESSION_CHECK_URL + '?token=' + encodeURIComponent(storedSid), {
            method: 'GET',
            credentials: 'omit', // Don't send cookies
          })
            .then(function (response) {
              return response.json();
            })
            .then(function (data) {
              if (data.active === false) {
                console.log('[SessionSync] Keycloak session inactive. Triggering logout.');
                // Clear local storage before logout
                localStorage.removeItem('zz_session_id');
                window.location.href = '/account/logout';
              } else {
                console.log('[SessionSync] Keycloak session is active.');
              }
            })
            .catch(function (error) {
              // Silently ignore errors (don't logout on network failure)
              console.warn('[SessionSync] Check failed (network error):', error);
            });
        }

        // Trigger on tab focus (visibilitychange)
        document.addEventListener('visibilitychange', function () {
          if (!document.hidden) {
            checkSessionStatus();
          }
        });

        // Also check on initial page load
        checkSessionStatus();
      }

      return;
    }

    // -------------------------------------------------------------------------
    // STRATEGY B.2: BOUNCE PAGE HANDLER
    // -------------------------------------------------------------------------
    // If we are on the Bounce Page (/pages/session-sync), our ONLY job is to:
    // 1. Extract #sid from URL
    // 2. Save it to LocalStorage
    // 3. Redirect to the 'target' query parameter
    if (window.location.pathname.includes('/pages/session-sync')) {
      console.log('[AutoLogin] Bounce Page Detected.');

      var hash = window.location.hash;
      if (hash && hash.includes('sid=')) {
        var sid = hash.split('sid=')[1].split('&')[0]; // Simple extract
        if (sid) {
          console.log('[AutoLogin] Captured SID from Bounce Page:', sid);
          localStorage.setItem('zz_session_id', sid);
          // Optional: Clear hash to be clean, though we are redirecting anyway
        }
      }

      var urlParams = new URLSearchParams(window.location.search);
      var target = urlParams.get('target');
      if (target) {
        console.log('[AutoLogin] Bouncing to target:', target);
        window.location.replace(target);
      } else {
        console.log('[AutoLogin] No target found on Bounce Page. Redirecting to account.');
        window.location.replace('/account');
      }
      return; // STOP execution of normal probe logic
    }

    // 2. Loop Prevention Check
    var hasChecked = sessionStorage.getItem(CHECK_FLAG);
    var lastProbeAt = parseInt(sessionStorage.getItem(LAST_PROBE_AT_KEY) || '0', 10);
    var withinCooldown = lastProbeAt && Date.now() - lastProbeAt < PROBE_COOLDOWN_MS;

    if (hasChecked && withinCooldown) {
      console.log('[AutoLogin] Already checked in this session (Probe sent). Skipping.');
      return;
    }

    // 3. Execution: Dispatch Probe
    console.log('[AutoLogin] dispatching Probe...');

    // CHECK FOR NEW SID IN HASH (Priority)
    // We now use #sid=... to avoid server logs/referer leakage
    var hash = window.location.hash;
    if (hash && hash.includes('sid=')) {
      var sid = hash.split('sid=')[1].split('&')[0];
      console.log('[AutoLogin] Found new SID in Hash:', sid);
      localStorage.setItem('zz_session_id', sid);

      // Clean up URL (Remove hash) to avoid ugly URL
      history.replaceState(null, null, window.location.pathname + window.location.search);
    } else {
      // Fallback: Check Query Param (Legacy support or if hash failed)
      var urlParams = new URLSearchParams(window.location.search);
      if (urlParams.has('sid')) {
        console.log('[AutoLogin] Found new SID in Query:', urlParams.get('sid'));
        localStorage.setItem('zz_session_id', urlParams.get('sid'));
      }
    }
    // Register probe on tab focus for anonymous users
    document.addEventListener('visibilitychange', function () {
      if (!document.hidden) {
        dispatchProbe();
      }
    });

    dispatchProbe();
  })();
</script>
