{% comment %}
  Session Sync V4 (Hybrid Hint Cookie Strategy)
  Intent: Cross-domain SSO synchronization between Shopify stores via Keycloak.

  Strategy:
  Phase 0: Set Hint Cookie on Login.
     - When user logs in on Site A, set KC_LOGGED_IN=1 on .zerozeroplatform.com.
     - This signals to Site B that a Keycloak session exists.

  Phase 1: Eager Redirect (Top-Level, Immediate).
     - On page load, if KC_LOGGED_IN=1 && Shopify user is anonymous:
       Redirect to Keycloak (prompt=none, state=PROBE).
     - Keycloak SPI handles PROBE state specially.
     - Cooldown (60s) prevents redirect loops.

  Phase 2: Iframe Background Check (Login + Logout Sync).
     - For ALL users (both anonymous and logged-in):
       Silent iframe check via Cloudflare Worker (bypasses X-Frame-Options).
     - Anonymous + active: set Hint Cookie + redirect to login.
     - Anonymous + inactive: clear stale Hint Cookie (self-healing).
     - Logged-in + inactive: clear Hint Cookie + redirect to logout (cross-site logout sync).

  Dependencies:
  - Cloudflare Worker at static.zerozeroplatform.com/session-check (Iframe redirect_uri)
  - Keycloak Client Config (Valid Redirect URIs, SPI Provider for state=PROBE)
  - KC_LOGGED_IN cookie on .zerozeroplatform.com (Shared Hint)
{% endcomment %}

<script>
  (function() {
    var CONFIG = {
      keycloakUrl: "https://auth-test.zerozeroplatform.com/realms/vcopter/protocol/openid-connect/auth",
      clientId: window.location.hostname === 'central-test.zerozeroplatform.com' ? 'shopify-fake-store-central' : 'shopify-fake-store',
      redirectUri: 'https://static.zerozeroplatform.com/session-check',
      loginRedirectUri: '/customer_authentication/login',
      logoutUri: '/account/logout',
      // V4: Cooldown is less critical because we rely on Hint Cookie, but still good for safety
      iframeCooldownMs: 5 * 1000
    };

    var STATE = {
      isLoggedIn: {{ customer | json }} !== null,
      lastIframeProbeAt: parseInt(sessionStorage.getItem('keycloak_v4_iframe_last_probe') || '0')
    };

    // --- V4 Helper: Cookie Management ---
    function getHintCookie() {
      var match = document.cookie.match(new RegExp('(^| )KC_LOGGED_IN=([^;]+)'));
      return match ? match[2] : null;
    }

    function setHintCookie() {
      var domain = '.zerozeroplatform.com';
      var maxAge = 30 * 24 * 60 * 60; // 30 days
      document.cookie = "KC_LOGGED_IN=1; path=/; domain=" + domain + "; max-age=" + maxAge + "; samesite=lax; secure";
    }

    function clearHintCookie() {
      var domain = '.zerozeroplatform.com';
      document.cookie = "KC_LOGGED_IN=; path=/; domain=" + domain + "; max-age=0; expires=Thu, 01 Jan 1970 00:00:00 GMT";
    }
    // ------------------------------------

    // --- V4 Phase 1: Eager Check (The "V2" Part) ---
    // If we have the Hint Cookie, and we are NOT logged in to Shopify, redirect IMMEDIATELY.
    // Use Cooldown to prevent loops if redirect fails (e.g., login failed, cookie stale).

    var lastEagerProbe = parseInt(sessionStorage.getItem('keycloak_v4_eager_ts') || '0');
    var now = Date.now();
    var EAGER_COOLDOWN = 60 * 1000; // 1 minute safety

    if (!STATE.isLoggedIn && getHintCookie() === '1' && (now - lastEagerProbe > EAGER_COOLDOWN)) {
      debugger;
      console.log('[SessionSyncV4] Hint found. Eager redirect.');

      sessionStorage.setItem('keycloak_v4_eager_ts', now); // Prevent Loop

      // V1 Style: Redirect to Keycloak aiming to return to Current Page
      // If session is active, Keycloak redirects back with ?code=...
      // If session inactive, Keycloak redirects back with ?error=login_required
      // In both cases, we handle it:
      // - Success: Shopify App handles code exchange (Standard OIDC)
      // - Failure: We stay anonymous, then Phase 2 (Iframe) will clean up the Stale Hint Cookie.

      var callbackUrl = window.location.href; // V1 style
      var probeUrl = CONFIG.keycloakUrl +
        '?client_id=' + encodeURIComponent(CONFIG.clientId) +
        '&redirect_uri=' + encodeURIComponent(callbackUrl) +
        '&response_type=code' +
        '&scope=openid' +
        '&prompt=none' + // CRITICAL: Silent Check
        '&state=' + (Math.random().toString(36).substring(2) + Date.now().toString(36)); // Random state for CSRF protection

      window.location.href = probeUrl;
      return;
    }
    // -----------------------------------------------

    function init() {
      debugger; // Phase 0: Init
      if (STATE.isLoggedIn) {
        // --- V4 Critical: Set Hint Cookie on Login ---
        setHintCookie();
      }

      // --- V4 Phase 2: Unified Iframe Check (Login + Logout Sync) ---
      // For anonymous users: detect active Keycloak session → auto login
      // For logged-in users: detect inactive Keycloak session → auto logout
      checkSession();
      document.addEventListener('visibilitychange', function() {
        if (!document.hidden) checkSession();
      });
      window.addEventListener('message', handleIframeMessage);
    }

    function checkSession() {
      var now = Date.now();
      if (now - STATE.lastIframeProbeAt < CONFIG.iframeCooldownMs) return;
      STATE.lastIframeProbeAt = now;
      sessionStorage.setItem('keycloak_v4_iframe_last_probe', now);

      console.log('[SessionSyncV4] Dispatching Iframe Probe...');
      createProbeIframe();
    }

    function createProbeIframe() {
      // V3 Strategy: Use Worker/CDN to bypass X-Frame-Options
      var frameId = 'auth-probe-frame-v4';
      var existing = document.getElementById(frameId);
      if (existing) existing.remove();

      var iframe = document.createElement('iframe');
      iframe.id = frameId;
      iframe.style.display = 'none';

      var url = CONFIG.keycloakUrl +
        '?client_id=' + encodeURIComponent(CONFIG.clientId) +
        '&redirect_uri=' + encodeURIComponent(CONFIG.redirectUri) + // Worker URL
        '&response_type=code' +
        '&scope=openid' +
        '&prompt=none';

      iframe.src = url;
      document.body.appendChild(iframe);

      setTimeout(function() {
        var el = document.getElementById(frameId);
        if (el) el.remove();
      }, 10000);
    }

    function handleIframeMessage(event) {
      if (event.origin !== new URL(CONFIG.redirectUri).origin) {
         // return; // Strict check recommended
      }

      if (event.data && event.data.type === 'KEYCLOAK_SESSION_STATUS') {
        console.log('[SessionSyncV4] Iframe Result:', event.data);

        if (event.data.status === 'active') {
          setHintCookie(); // Refresh Hint
          if (!STATE.isLoggedIn) {
             console.log('[SessionSyncV4] Active! Redirecting to login...');
             window.location.href = CONFIG.loginRedirectUri + '?return_to=' + encodeURIComponent(window.location.pathname);
          }
          // Logged-in + active → normal, do nothing
        } else {
          // --- Logout Sync: Logged-in user + Keycloak inactive ---
          if (STATE.isLoggedIn) {
             console.log('[SessionSyncV4] Keycloak inactive. Syncing logout.');
             clearHintCookie();
             window.location.href = CONFIG.logoutUri + '?return_to=' + encodeURIComponent(window.location.pathname);
             return;
          }
          // --- Self-Correction: Anonymous user + stale cookie ---
          if (getHintCookie()) {
             console.warn('[SessionSyncV4] Stale Hint Cookie. Clearing.');
             clearHintCookie();
          }
        }
      }
    }

    // Start
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
