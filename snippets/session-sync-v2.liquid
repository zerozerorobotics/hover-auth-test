{% comment %}
  Session Sync V4 (Hybrid Hint Cookie Strategy)
  Intent: Cross-domain SSO synchronization between Shopify stores via Keycloak.

  Strategy:
  Phase 0: Set Hint Cookie on Login.
     - When user logs in on Site A, set KC_LOGGED_IN=1 on the root domain (e.g., .hoverair.com).
     - This signals to Site B that a Keycloak session exists.

  Phase 1: Eager Redirect (Top-Level, Immediate).
     - On page load, if KC_LOGGED_IN=1 && Shopify user is anonymous:
       Redirect to Keycloak (prompt=none, state=PROBE).
     - Keycloak SPI handles PROBE state specially.
     - Cooldown (60s) prevents redirect loops.

  Phase 2: Iframe Background Check (Login + Logout Sync).
     - For ALL users (both anonymous and logged-in):
       Silent iframe check via Cloudflare Worker (bypasses X-Frame-Options).
     - Anonymous + active: set Hint Cookie + redirect to login.
     - Anonymous + inactive: clear stale Hint Cookie (self-healing).
     - Logged-in + inactive: clear Hint Cookie + redirect to logout (cross-site logout sync).

  Dependencies:
  - Cloudflare Worker at static.zerozeroplatform.com/session-check (Iframe redirect_uri)
  - Keycloak Client Config (Valid Redirect URIs, SPI Provider for state=PROBE)
  - KC_LOGGED_IN cookie on the root domain (Shared Hint)
{% endcomment %}

{% comment %} Client ID & Keycloak URL Map {% endcomment %}
{% if shop.domain == 'central-test.hoverair.com' %}
  {% assign client_id = 'shopify-fake-store-central' %}
  {% assign keycloak_url = 'https://auth-test.hoverair.com/realms/central/protocol/openid-connect/auth' %}
{% elsif shop.domain == 'us-test.hoverair.com' %}
  {% assign client_id = 'shopify-fake-store' %}
  {% assign keycloak_url = 'https://auth-test.hoverair.com/realms/vcopter/protocol/openid-connect/auth' %}
{% elsif shop.domain == 'uk.hoverair.com' %}
  {% assign client_id = 'zerozerorobotics-hoverair-uk' %}
  {% assign keycloak_url = 'https://auth.hoverair.com/realms/hoverair/protocol/openid-connect/auth' %}
{% elsif shop.domain == 'global.hoverair.com' %}
  {% assign client_id = 'zerozerorobotics-hoverair-global' %}
  {% assign keycloak_url = 'https://auth.hoverair.com/realms/hoverair/protocol/openid-connect/auth' %}
{% endif %}

{% if session_sync_phase == 'eager' %}
  <script>
    (function() {
      if (!'{{ client_id }}') {
        return;
      }

      var ua = window.navigator.userAgent;
      var appMatch = ua.match(/Hover(?: X1)?\/([\d.]+)/i);
      if (appMatch) {
        return;
      }

      var isLoggedIn = {{ customer | json }} !== null;
      if (isLoggedIn) {
        return;
      }

      function getHintCookie() {
        var match = document.cookie.match(new RegExp('(^| )KC_LOGGED_IN=([^;]+)'));
        return match ? match[2] : null;
      }

      var lastEagerProbe = parseInt(sessionStorage.getItem('keycloak_v4_eager_ts') || '0', 10);
      var now = Date.now();
      var eagerCooldown = 60 * 1000;

      if (getHintCookie() !== '1' || (now - lastEagerProbe <= eagerCooldown)) {
        return;
      }

      console.log('[SessionSyncV4] Hint found. Eager redirect.');

      sessionStorage.setItem('keycloak_v4_eager_ts', now);
      localStorage.removeItem('keycloak_v4_session_state');

      var callbackUrl = window.location.href;
      var probeUrl = '{{ keycloak_url }}' +
        '?client_id=' + encodeURIComponent('{{ client_id }}') +
        '&redirect_uri=' + encodeURIComponent(callbackUrl) +
        '&response_type=code' +
        '&scope=openid' +
        '&prompt=none' +
        '&state=PROBE_' + (Math.random().toString(36).substring(2) + Date.now().toString(36));

      window.location.href = probeUrl;
    })();
  </script>
{% else %}
  <script>
    (function() {
      if (!'{{ client_id }}') {
        console.log('[SessionSyncV4] Client ID is empty. Skipping execution.');
        return;
      }

      var ua = window.navigator.userAgent;
      var appMatch = ua.match(/Hover(?: X1)?\/([\d.]+)/i);
      if (appMatch) {
        console.log('[SessionSyncV4] Skipped execution inside App WebView.');
        return;
      }

      var CONFIG = {
        keycloakUrl: '{{ keycloak_url }}',
        clientId: '{{ client_id }}',
        redirectUri: 'https://static.zerozeroplatform.com/session-check',
        loginRedirectUri: '/customer_authentication/login',
        logoutUri: '/account/logout',
        iframeCooldownMs: 5 * 1000
      };

      var STATE = {
        isLoggedIn: {{ customer | json }} !== null,
        lastIframeProbeAt: parseInt(sessionStorage.getItem('keycloak_v4_iframe_last_probe') || '0', 10)
      };

      function getRootDomain() {
        var hostname = window.location.hostname;
        if (hostname === 'localhost' || hostname.match(/^[0-9.]+$/)) return hostname;
        if (hostname.indexOf('.myshopify.com') !== -1) return hostname;

        var parts = hostname.split('.');
        return '.' + parts.slice(-2).join('.');
      }

      function getHintCookie() {
        var match = document.cookie.match(new RegExp('(^| )KC_LOGGED_IN=([^;]+)'));
        return match ? match[2] : null;
      }

      function setHintCookie() {
        var domain = getRootDomain();
        var maxAge = 30 * 24 * 60 * 60;
        document.cookie = 'KC_LOGGED_IN=1; path=/; domain=' + domain + '; max-age=' + maxAge + '; samesite=lax; secure';
      }

      function clearHintCookie() {
        var domain = getRootDomain();
        document.cookie = 'KC_LOGGED_IN=; path=/; domain=' + domain + '; max-age=0; expires=Thu, 01 Jan 1970 00:00:00 GMT';
      }

      function getSessionState() {
        return localStorage.getItem('keycloak_v4_session_state');
      }

      function setSessionState(stateStr) {
        if (stateStr) {
          localStorage.setItem('keycloak_v4_session_state', stateStr);
        }
      }

      function clearSessionState() {
        localStorage.removeItem('keycloak_v4_session_state');
      }

      function init() {
        if (STATE.isLoggedIn) {
          setHintCookie();
        }

        checkSession();
        document.addEventListener('visibilitychange', function() {
          if (!document.hidden) checkSession();
        });
        window.addEventListener('message', handleIframeMessage);
      }

      function checkSession() {
        var now = Date.now();
        if (now - STATE.lastIframeProbeAt < CONFIG.iframeCooldownMs) return;
        STATE.lastIframeProbeAt = now;
        sessionStorage.setItem('keycloak_v4_iframe_last_probe', now);

        console.log('[SessionSyncV4] Dispatching Iframe Probe...');
        createProbeIframe();
      }

      function createProbeIframe() {
        var frameId = 'auth-probe-frame-v4';
        var existing = document.getElementById(frameId);
        if (existing) existing.remove();

        var iframe = document.createElement('iframe');
        iframe.id = frameId;
        iframe.style.display = 'none';

        var url = CONFIG.keycloakUrl +
          '?client_id=' + encodeURIComponent(CONFIG.clientId) +
          '&redirect_uri=' + encodeURIComponent(CONFIG.redirectUri) +
          '&response_type=code%20id_token' +
          '&scope=openid' +
          '&nonce=' + Math.random().toString(36).substring(2) + Date.now().toString(36) +
          '&prompt=none';

        iframe.src = url;
        document.body.appendChild(iframe);

        setTimeout(function() {
          var el = document.getElementById(frameId);
          if (el) el.remove();
        }, 10000);
      }

      function handleIframeMessage(event) {
        if (event.origin !== new URL(CONFIG.redirectUri).origin) {
          // return; // Strict check recommended
        }

        if (event.data && event.data.type === 'KEYCLOAK_SESSION_STATUS') {
          console.log('[SessionSyncV4] Iframe Result:', event.data);

          if (event.data.status === 'active') {
            setHintCookie();

            var incomingState = event.data.session_state;
            var localState = getSessionState();

            window.__ZZ_ANALYTICS_CONTEXT__ = window.__ZZ_ANALYTICS_CONTEXT__ || {};
            if (event.data.userId) {
              window.__ZZ_ANALYTICS_CONTEXT__.huid = event.data.userId;
            }

            if (!STATE.isLoggedIn) {
              console.log('[SessionSyncV4] Active! Redirecting to login...');
              clearSessionState();
              window.location.href = CONFIG.loginRedirectUri + '?return_to=' + encodeURIComponent(window.location.pathname);
            } else if (!localState) {
              if (incomingState) {
                setSessionState(incomingState);
              }
            } else if (incomingState && incomingState !== localState) {
              console.warn('[SessionSyncV4.1] CRITICAL: Account mismatch detected across tabs. Forcing logout & resync.');
              setHintCookie();
              clearSessionState();
              sessionStorage.removeItem('keycloak_v4_eager_ts');
              window.location.href = CONFIG.logoutUri + '?return_to=' + encodeURIComponent(window.location.pathname);
            }
          } else {
            if (STATE.isLoggedIn) {
              console.log('[SessionSyncV4] Keycloak inactive. Syncing logout.');
              clearHintCookie();
              clearSessionState();
              window.location.href = CONFIG.logoutUri + '?return_to=' + encodeURIComponent(window.location.pathname);
              return;
            }

            if (getHintCookie()) {
              console.warn('[SessionSyncV4] Stale Hint Cookie. Clearing.');
              clearHintCookie();
              clearSessionState();
            }
          }
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
    })();
  </script>
{% endif %}
